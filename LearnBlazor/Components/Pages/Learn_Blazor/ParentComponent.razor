@page "/learnBlazor/parentComponent"
@rendermode InteractiveServer

<h3>ParentComponent</h3>

<_ChildComponent OnButtonClicked="ShowMessage" Title="This title is passed as a parameter in the Parent Component">
    <ChildContent>Some Text between the Tags from Parent Component!</ChildContent>
    <ChildSomeContent>Some Text between the Tags from Parent Component!</ChildSomeContent>
</_ChildComponent>

<p>@messageText</p>

<_ChildComponent Title="This title is passed as a parameter in the Parent Component">
</_ChildComponent>


@code {
    public string messageText = "";

    private void ShowMessage()
    {
        messageText = "Button inside child component was clicked";
    }
}