@page "/learnBlazor/parentComponent"
@rendermode InteractiveServer

<h3>ParentComponent</h3>

<CascadingValue Value="MessageForGrandChild" Name="Message">
    <CascadingValue Value="LuckyNumber" Name="LuckyNumber">
        <_ChildComponent MessageForGrandChild="" OnButtonClicked="ShowMessage" Title="This title is passed as a parameter in the Parent Component">
            <ChildContent>Some Text between the Tags from Parent Component!</ChildContent>
            <ChildSomeContent>Some Text between the Tags from Parent Component!</ChildSomeContent>
        </_ChildComponent>
    </CascadingValue>
</CascadingValue>

<p>@messageText</p>


@code {
    public string MessageForGrandChild = "This message is passed from Parent Component to Grand Child";
    public string LuckyNumber = "7";
    public string messageText = "";

    private void ShowMessage()
    {
        messageText = "Button inside child component was clicked";
    }

}